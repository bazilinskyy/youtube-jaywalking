{
  "project_name": "crowd-jaywalking",
  "version": "1.0.0",
  "vlm_model": "qwen2.5vl:7b",
  "vlm_api_base": "http://localhost:11434",
  "vlm_temperature": 0.0,
  "vlm_seed": 42,
  "vlm_num_keyframes": 3,
  "tracking_model_path": "yolo26x-pose.pt",
  "tracking_tracker_config": "configs/botsort_custom.yaml",
  "tracking_conf_thresh": 0.25,
  "tracking_iou_thresh": 0.5,
  "segmentation_model_name": "nvidia/segformer-b0-finetuned-cityscapes-512-1024",
  "segmentation_device": "cuda",
  "segmentation_contact_radius_px": 24,
  "video_dir": "videos",
  "jaad_video_dir": "jaad_pedestrian_100/videos",
  "development_manifest": "datasets/manifests/development_manifest.csv",
  "locked_test_manifest": "datasets/manifests/locked_test_manifest.csv",
  "output_dir": "results",
  "font_family": "Open Sans, verdana, arial, sans-serif",
  "font_size": 18,
  "plotly_template": "plotly_white",
  "logger_level": "info"
}

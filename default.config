{
  "project_name": "crowd-jaywalking",
  "version": "1.0.0",
  "vlm": {
    "model": "qwen2.5vl:7b",
    "api_base": "http://localhost:11434",
    "temperature": 0.0,
    "seed": 42,
    "num_keyframes": 3
  },
  "tracking": {
    "model_path": "yolo26x-pose.pt",
    "tracker_config": "configs/botsort_custom.yaml",
    "conf_thresh": 0.25,
    "iou_thresh": 0.5
  },
  "segmentation": {
    "model_name": "nvidia/segformer-b0-finetuned-cityscapes-512-1024",
    "device": "cuda",
    "contact_radius_px": 24
  },
  "paths": {
    "video_dir": "videos",
    "jaad_video_dir": "jaad_pedestrian_100/videos",
    "development_manifest": "datasets/manifests/development_manifest.csv",
    "locked_test_manifest": "datasets/manifests/locked_test_manifest.csv",
    "canonical_mapping": "experiments/legacy/mapping.csv",
    "output_dir": "results"
  }
}
